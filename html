body{font-family:'Segoe UI',Tahoma,Geneva,Verdana,sans-serif;color:var(--text);background:#fff;line-height:1.6}

/* HEADER */
header{background:linear-gradient(135deg,var(--brand),#3aa0ff);color:#fff;box-shadow:0 2px 10px rgba(0,0,0,.1);position:sticky;top:0;z-index:100}
.top-bar{background:rgba(0,0,0,.1);padding:8px 0;font-size:13px;text-align:center}
.nav-main{display:flex;align-items:center;gap:20px;padding:15px 0;flex-wrap:wrap}
.logo{font-weight:800;font-size:24px;text-decoration:none;color:#fff}
.nav-links{display:flex;gap:20px;flex:1;justify-content:center;flex-wrap:wrap}
.nav-links a{color:#fff;text-decoration:none;padding:8px 16px;border-radius:8px;transition:.3s}
.nav-links a:hover{background:rgba(255,255,255,.2)}
.search{flex:1;max-width:400px;min-width:200px}
.search input{padding:12px 16px;border-radius:10px;border:0;width:100%;font-size:14px}
.cart-btn{background:rgba(255,255,255,.25);border:2px solid rgba(255,255,255,.5);color:#fff;padding:10px 20px;border-radius:10px;cursor:pointer;font-weight:600;transition:.3s}
.cart-btn:hover{background:rgba(255,255,255,.35)}

.container{max-width:1200px;margin:auto;padding:20px}

/* HERO */
.hero{background:linear-gradient(135deg,#667eea 0%,#764ba2 100%);color:#fff;padding:60px 0;margin-bottom:40px}
.hero-content{display:grid;grid-template-columns:1fr 1fr;gap:50px;align-items:center}
.hero h1{font-size:48px;margin-bottom:20px;line-height:1.2}
.hero p{font-size:20px;margin-bottom:25px;opacity:.95}
.hero-btn{background:#fff;color:var(--brand);padding:15px 35px;border:0;border-radius:10px;font-size:18px;font-weight:700;cursor:pointer;transition:.3s}
.hero-btn:hover{transform:translateY(-2px);box-shadow:0 10px 25px rgba(0,0,0,.2)}
.hero img{width:100%;border-radius:20px;box-shadow:0 25px 50px rgba(0,0,0,.3)}

/* CARACTERÍSTICAS */
.features{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:30px;margin:50px 0}
.feature-card{text-align:center;padding:30px;background:var(--bg-light);border-radius:15px;transition:.3s}
.feature-card:hover{transform:translateY(-5px);box-shadow:0 10px 30px rgba(0,0,0,.1)}
.feature-icon{font-size:48px;margin-bottom:15px}
.feature-card h3{color:var(--brand);margin-bottom:10px}

/* SECCIONES DE CONTENIDO */
.content-section{margin:60px 0;padding:40px;background:var(--bg-light);border-radius:15px}
.content-section h2{color:var(--brand);font-size:32px;margin-bottom:20px;border-bottom:3px solid var(--brand);padding-bottom:10px}
.content-section p{margin-bottom:15px;font-size:16px}
.content-section ul{margin-left:25px;margin-bottom:15px}
.content-section li{margin-bottom:8px}

/* PRODUCTOS */
.products-section{margin:50px 0}
.section-title{text-align:center;font-size:36px;color:var(--brand);margin-bottom:40px}
.products{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:25px}
.card{border:1px solid #e0e0e0;border-radius:15px;background:#fff;overflow:hidden;transition:.3s;box-shadow:0 2px 8px rgba(0,0,0,.08)}
.card:hover{transform:translateY(-8px);box-shadow:0 15px 35px rgba(0,0,0,.15)}
.card img{width:100%;height:200px;object-fit:cover}
.card .info{padding:20px}
.card h3{font-size:18px;margin-bottom:10px;color:var(--text)}
.card .description{font-size:14px;color:#666;margin-bottom:15px}
.price{font-weight:700;font-size:24px;color:var(--brand);margin:15px 0}
.add{background:var(--brand);color:#fff;border:0;padding:12px;border-radius:10px;width:100%;font-size:16px;font-weight:600;cursor:pointer;transition:.3s}
.add:hover{background:var(--brand-dark)}

/* ADSENSE CONTAINERS */
.ad-container{margin:40px 0;text-align:center;min-height:100px;background:#f5f5f5;border-radius:10px;padding:20px}

/* FOOTER */
footer{background:#2c3e50;color:#ecf0f1;padding:50px 0 20px;margin-top:80px}
.footer-content{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:40px;margin-bottom:30px}
.footer-section h3{color:#fff;margin-bottom:15px;font-size:20px}
.footer-section p,.footer-section li{color:#bdc3c7;font-size:14px;margin-bottom:8px}
.footer-section a{color:#3498db;text-decoration:none}
.footer-section a:hover{color:#5dade2}
.footer-bottom{text-align:center;padding-top:20px;border-top:1px solid #34495e;color:#95a5a6}

/* MODAL */
.modal{display:none;position:fixed;inset:0;background:rgba(0,0,0,.7);z-index:9999;align-items:center;justify-content:center;padding:20px}
.modal-content{background:#fff;padding:30px;border-radius:20px;width:90%;max-width:500px;max-height:90vh;overflow-y:auto}
.modal h3{color:var(--brand);margin-bottom:20px;font-size:28px}
.cart-item{display:flex;justify-content:space-between;padding:15px;border-bottom:1px solid #eee;align-items:center}
.cart-empty{text-align:center;padding:40px;color:#999}
.modal-footer{margin-top:20px;padding-top:20px;border-top:2px solid #eee}
.modal-total{font-size:24px;font-weight:700;color:var(--brand);margin-bottom:20px}
.btn-close{background:#95a5a6;color:#fff;padding:12px;border:0;border-radius:10px;width:100%;cursor:pointer;font-size:16px;margin-top:10px}
.btn-close:hover{background:#7f8c8d}

@media(max-width:768px){
