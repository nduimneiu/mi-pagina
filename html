<script>
// PayPal
paypal.HostedButtons({hostedButtonId:"LPVYHJGP49RU2"}).render("#paypal-container-LPVYHJGP49RU2");

// Productos
const productos=[
  {id:1,titulo:"Laptop Profesional HP",precio:829.99,img:"https://images.pexels.com/photos/18105/pexels-photo.jpg?auto=compress&cs=tinysrgb&w=400",desc:"Intel i7, 16GB RAM, 512GB SSD"},
  {id:2,titulo:"iPhone 14 Pro",precio:999.99,img:"https://images.pexels.com/photos/788946/pexels-photo-788946.jpeg?auto=compress&cs=tinysrgb&w=400",desc:"128GB, Cámara 48MP, 5G"},
  {id:3,titulo:"Auriculares Sony WH-1000XM5",precio:349.99,img:"https://images.pexels.com/photos/3394650/pexels-photo-3394650.jpeg?auto=compress&cs=tinysrgb&w=400",desc:"Cancelación de ruido, 30h batería"},
  {id:4,titulo:"Apple Watch Series 9",precio:429.99,img:"https://images.pexels.com/photos/437037/pexels-photo-437037.jpeg?auto=compress&cs=tinysrgb&w=400",desc:"GPS, Monitor salud, Resistente agua"},
  {id:5,titulo:"iPad Pro 12.9",precio:1099.99,img:"https://images.pexels.com/photos/1334597/pexels-photo-1334597.jpeg?auto=compress&cs=tinysrgb&w=400",desc:"M2, 256GB, Liquid Retina XDR"},
  {id:6,titulo:"Samsung Galaxy S24 Ultra",precio:1199.99,img:"https://images.pexels.com/photos/1092644/pexels-photo-1092644.jpeg?auto=compress&cs=tinysrgb&w=400",desc:"512GB, S Pen, Cámara 200MP"},
  {id:7,titulo:"MacBook Pro 14",precio:1999.99,img:"https://images.pexels.com/photos/812264/pexels-photo-812264.jpeg?auto=compress&cs=tinysrgb&w=400",desc:"M3 Pro, 18GB RAM, 512GB SSD"},
  {id:8,titulo:"AirPods Pro 2",precio:249.99,img:"https://images.pexels.com/photos/3780681/pexels-photo-3780681.jpeg?auto=compress&cs=tinysrgb&w=400",desc:"USB-C, Cancelación adaptativa"}
];

const productsEl=document.getElementById("products");
const cartCount=document.getElementById("cartCount");
const cartItems=document.getElementById("cartItems");
const cartTotal=document.getElementById("cartTotal");
const modal=document.getElementById("cartModal");
document.getElementById("year").textContent=new Date().getFullYear();

let cart=[];

function renderProducts(){
  productsEl.innerHTML="";
  productos.forEach(p=>{
    productsEl.innerHTML+=`
    <div class="card">
      <img src="${p.img}" alt="${p.titulo}">
      <div class="info">
        <h3>${p.titulo}</h3>
        <p class="description">${p.desc}</p>
        <div class="price">$${p.precio.toFixed(2)}</div>
        <button class="add" onclick="addToCart(${p.id})">Agregar al Carrito</button>
      </div>
    </div>`;
  });
}

function addToCart(id){
  const producto=productos.find(p=>p.id===id);
  cart.push(producto);
  cartCount.textContent=cart.length;
  
  // Feedback visual
  const btn=event.target;
  const originalText=btn.textContent;
  btn.textContent="✓ Agregado";
  btn.style.background="#27ae60";
  setTimeout(()=>{
    btn.textContent=originalText;
    btn.style.background="";
  },1500);
}

document.getElementById("cartBtn").onclick=()=>{
  if(cart.length===0){
    cartItems.innerHTML='<div class="cart-empty">Tu carrito está vacío<br>¡Explora nuestros productos!</div>';
    cartTotal.textContent="0.00";
  }else{
    cartItems.innerHTML="";
    let total=0;
    cart.forEach((p,idx)=>{
      total+=p.precio;
      cartItems.innerHTML+=`
      <div class="cart-item">
        <div>
          <strong>${p.titulo}</strong><br>
          <small style="color:#666">${p.desc}</small>
        </div>
        <div style="text-align:right">
          <div style="font-weight:700;color:var(--brand)">$${p.precio.toFixed(2)}</div>
          <button onclick="removeFromCart(${idx})" style="background:none;border:none;color:#e74c3c;cursor:pointer;font-size:12px">Eliminar</button>
        </div>
      </div>`;
    });
    cartTotal.textContent=total.toFixed(2);
  }
  modal.style.display="flex";
};

function removeFromCart(idx){
  cart.splice(idx,1);
  cartCount.textContent=cart.length;
  document.getElementById("cartBtn").onclick();
}

function closeCart(){
  modal.style.display="none";
}

